{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "top=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && [ -f \"$top/.claude/hooks/guard_bash.py\" ] && exec python3 \"$top/.claude/hooks/guard_bash.py\"; exit 0",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
